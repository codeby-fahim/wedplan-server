# Server
PORT=5000

# MongoDB
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net

# Public origin of the Next.js client (used for CORS + Stripe return URLs)
CLIENT_URL=http://localhost:3000

# Auth — must point to the CLIENT origin (JWKS is fetched from here)
BETTER_AUTH_URL=http://localhost:3000

# Stripe — sandbox (sk_test / price_ from test mode) for testing,
# sk_live / price_ from live mode for production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT claims — must match the jwt() options in the client's src/lib/auth.ts
JWT_ISSUER=wedplan-server
JWT_AUDIENCE=wedplan-client
